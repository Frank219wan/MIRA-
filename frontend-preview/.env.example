# Default is offline Demo. Set false to request the existing FastAPI contract.
VITE_DEMO_MODE=true
VITE_MOCK_FALLBACK=true
# Vite dev proxies /api to http://127.0.0.1:8000 (no backend CORS changes needed).
# Production requires a same-origin /api reverse proxy, or a CORS-enabled API URL.
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=30000
# Server-readable path for the example tutorial; never a browser File.name or URL.
VITE_EXAMPLE_MEDIA_PATH=
VITE_EXAMPLE_MEDIA_KIND=video
